# API and worker explicitly load .env.local from repository root.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME
DATABASE_URL=postgresql://USER:ESCAPED_PASSWORD@HOST:5432/postgres?sslmode=require
TOKEN_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
INFRA_HEALTH_KEY=CHANGE_ME_RANDOM_SECRET
API_PUBLIC_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:5173
# Instagram product credentials: Instagram > API setup with Instagram login.
# These are NOT the generic Facebook app ID/secret.
META_APP_ID=
META_APP_SECRET=
# Optional explicit aliases: META_INSTAGRAM_APP_ID / META_INSTAGRAM_APP_SECRET.
# Explicit signing secret: this Instagram Login sender was verified to use
# the Instagram App Secret. Configure explicitly; no runtime fallback/auto-copy.
META_WEBHOOK_APP_SECRET=
META_API_VERSION=
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_INDEPENDENT_RANDOM_SECRET
DISPATCHES_PAUSED=true
# Complete only after real Meta validation; no dispatcher exists in M0.
META_MAX_MESSAGE_LENGTH=1000
META_MESSAGE_LENGTH_UNIT=bytes

# Explicit public contact information for /privacy; never inferred from login.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_CONTACT_URL=

# Maximum lifetime of the encrypted server-side Supabase cockpit session
COCKPIT_SESSION_SECONDS=604800
