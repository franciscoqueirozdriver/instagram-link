  "components": {
    "schemas": {
      "Campaign": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Name"
          },
          "publication_id": {
            "type": "string",
            "format": "uuid",
            "title": "Publication Id"
          },
          "product_id": {
            "type": "string",
            "format": "uuid",
            "title": "Product Id"
          },
          "include": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Include"
          },
          "exclude": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Exclude",
            "default": []
          },
          "ignore_accents": {
            "type": "boolean",
            "title": "Ignore Accents",
            "default": false
          },
          "template": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Template"
          },
          "expected_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Version"
          }
        },
        "type": "object",
        "required": [
          "name",
          "publication_id",
          "product_id",
          "include",
          "template"
        ],
        "title": "Campaign"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InviteSession": {
        "properties": {
          "access_token": {
            "type": "string",
            "maxLength": 8192,
            "minLength": 1,
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "maxLength": 8192,
            "minLength": 1,
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token"
        ],
        "title": "InviteSession"
      },
      "Link": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Label"
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "label",
          "url"
        ],
        "title": "Link"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "MediaSync": {
        "properties": {
          "load_more": {
            "type": "boolean",
            "title": "Load More",
            "default": false
          }
        },
        "type": "object",
        "title": "MediaSync"
      },
      "PasswordChange": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 12,
            "title": "Password"
          },
          "confirmation": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 12,
            "title": "Confirmation"
          }
        },
        "type": "object",
        "required": [
          "password",
          "confirmation"
        ],
        "title": "PasswordChange"
      },
      "PauseCampaign": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          }
        },
        "type": "object",
        "required": [
          "expected_version"
        ],
        "title": "PauseCampaign"
      },
      "Product": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 3000,
            "title": "Description",
            "default": ""
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Links"
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": true
          },
          "expected_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Version"
          }
        },
        "type": "object",
        "required": [
          "name",
          "links"
        ],
        "title": "Product"
      },
      "Review": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "positive": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Positive"
          },
          "negative": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Negative"
          }
        },
        "type": "object",
        "required": [
          "expected_version",
          "positive",
          "negative"
        ],
        "title": "Review"
      },
      "ShopeeCredentials": {
        "properties": {
          "app_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "App Id"
          },
          "app_secret": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "format": "password",
            "title": "App Secret",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "app_id",
          "app_secret"
        ],
        "title": "ShopeeCredentials"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
