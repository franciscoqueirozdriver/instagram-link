# Exemplo documental; sem credenciais reais. Implementação deve validar no startup.
APP_ENV=development
PUBLIC_APP_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/instagram_link
SESSION_SECRET=CHANGE_ME_RANDOM_SECRET
TOKEN_ENCRYPTION_KEY=CHANGE_ME_FROM_SECRET_MANAGER
META_APP_ID=CHANGE_ME
META_APP_SECRET=CHANGE_ME
META_API_VERSION=REQUIRED_SUPPORTED_VERSION
META_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_RANDOM_INDEPENDENT_SECRET
META_MAX_MESSAGE_LENGTH=REQUIRED_VALIDATED_LIMIT
# Unit do limite deve ser validada com a Meta: bytes/codepoints conforme endpoint.
META_MESSAGE_LENGTH_UNIT=REQUIRED_VALIDATED_UNIT
DISPATCHES_PAUSED=true
PRIVATE_REPLY_WINDOW_SECONDS=604800
PRIVATE_REPLY_SAFETY_MARGIN_SECONDS=300
PRIVATE_REPLY_LOCAL_HOURLY_BUDGET=600
RECIPIENT_CAMPAIGN_COOLDOWN_SECONDS=86400
WORKER_POLL_SECONDS=2
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_READ_TIMEOUT_SECONDS=20
DEFAULT_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
# Não colocar IG access token aqui em produção: armazenar criptografado por conta.
